# Copia este archivo a .env y ajústalo (install.sh lo hace por ti la primera vez).

# Carpeta donde se guardan TODOS los datos (personas, mascotas y fotos).
# En una Raspberry Pi conviene que esté en un disco externo, no en la tarjeta SD.
# Ejemplo: DATA_DIR=/mnt/disco/mascotaspanel
DATA_DIR=./data

# Opcional: dirección pública si tienes dominio (por ejemplo https://mascotas.midominio.com).
# Es la que llevan los QR y los carteles. También se puede poner en el panel: Administración.
PUBLIC_URL=

# Puerto en el que se abre la web (http://IP-DE-TU-PI:8093)
PORT=8093

# Zona horaria
TZ=Europe/Madrid

# UID/GID del usuario dueño de los archivos (mira el tuyo con: id -u ; id -g)
PUID=1000
PGID=1000

# Opcional: crea este administrador al arrancar si no existe (correo y contraseña).
# Si lo dejas vacío, la primera persona que se registre será la administradora.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 1 = cualquiera puede registrarse (es un registro libre); 0 = registro cerrado
ALLOW_REGISTER=1

# Mascotas por persona
MAX_PETS=20

# Para el aviso de privacidad (RGPD): quién es el responsable y un correo de contacto.
# Si abres el registro a otras personas, rellénalo.
OWNER_NAME=
CONTACT_EMAIL=
